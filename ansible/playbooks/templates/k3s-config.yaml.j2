---
write-kubeconfig-mode: "644"
flannel-ipv6-masq: true
disable-cloud-controller: true
disable:
  - servicelb
  - traefik
# Built-in network policy controller (kube-router), enforces NetworkPolicy with Flannel
disable-network-policy: false
kubelet-arg:
  # CoreDNS (packaged with K3s) forwards to the resolver listed in this file (Unbound)
  - "resolv-conf=/etc/rancher/k3s/resolv.conf"
node-ip: "{{ ansible_facts.default_ipv6.address }}"
node-external-ip: "{{ ansible_facts.default_ipv6.address }}"
tls-san:
  - "{{ k3s_api_fqdn }}"
secrets-encryption: true
cluster-cidr: "{{ k3s_cluster_cidr_v6 }}"
service-cidr: "{{ k3s_service_cidr_v6 }}"
