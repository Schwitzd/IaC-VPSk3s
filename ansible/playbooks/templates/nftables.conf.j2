#!/usr/sbin/nft -f

table inet filter
flush table inet filter

define WAN_IF      = "{{ nftables_wan_if }}"
define WG_IF       = "{{ nftables_wg_if }}"

table inet filter {
    chain input {
        type filter hook input priority 0; policy drop;

        # Loopback
        iifname "lo" accept

        # Established / related
        ct state established,related accept

        # ICMPv6 (required for neighbor discovery and path MTU discovery)
        ip6 nexthdr ipv6-icmp accept

        # SSH
        tcp dport 22 accept

        # WireGuard handshake on WAN
        iifname $WAN_IF udp dport 51821 accept

        ## Allow HTTPS via the WireGuard tunnel
        iifname $WG_IF tcp dport 443 accept

        # Allow Kubectl via Wireguard tunnel
        iifname $WG_IF tcp dport 6443 accept

        # PostgresQL via Wireguard tunnel
        iifname $WG_IF tcp dport 5432 accept

        ## Kubernetes
        # Allow pod traffic to reach services running on this node (API server, kubelet, CSI, etc.)
        iifname "cni0" accept

        # Allow traffic from the flannel interface to reach this node
        iifname "flannel-v6.1" accept
    }

    chain forward {
        type filter hook forward priority filter; policy drop;

        # Return traffic of allowed connections (this also covers ICMPv6 errors such as path MTU discovery)
        ct state established,related accept
        ct state invalid drop

        # Pods can go anywhere: other pods, the internet (including NAT64) and the home network through WireGuard.
        # What pods may actually reach is restricted by the Kubernetes NetworkPolicies.
        iifname "cni0" accept

        # Internet -> pods through the hostPorts: HTTPS only
        iifname $WAN_IF oifname "cni0" tcp dport 443 accept

        # WireGuard -> pods through the hostPorts: HTTPS and PostgreSQL
        iifname $WG_IF oifname "cni0" tcp dport { 443, 5432 } accept

        # Log what is left before the policy drops it (rate limited)
        limit rate 5/minute log prefix "nft-forward-drop: "
    }

    chain output {
        type filter hook output priority 0; policy accept
    }
}
